# Backend — copy this to backend/.env
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key   # free at firms.modaps.eosdis.nasa.gov/api/
OPENAQ_API_KEY=your_openaq_v3_key            # free at explore.openaq.org (v3 requires a key)
ALLOWED_ORIGINS=http://localhost:5173        # comma-separated; deployed frontend URL in prod

# Frontend — copy this to frontend/.env
VITE_API_URL=http://localhost:8000
